# Copy this file to `backend/.env` and fill in real values:
#   cp .env.example .env
#
# application.properties resolves every secret from the environment and imports this
# file (spring.config.import=optional:file:.env) when you run the backend locally,
# so no credentials belong in application.properties itself.
# `.env` is gitignored -- never commit real credentials.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kanban
SPRING_DATASOURCE_USERNAME=kanban
SPRING_DATASOURCE_PASSWORD=

# Signing key for JWTs. Generate one, e.g.: openssl rand -base64 32
JWT_SECRET_KEY=

# Both empty turns mail off: the app starts and drops messages rather than refusing to boot,
# which is what lets a fresh clone run the suite without an Azure account.
# Connection string: Azure portal -> your Communication Services resource -> Keys.
ACS_EMAIL_CONNECTION_STRING=
# Must be an address the linked domain has - `DoNotReply@<guid>.azurecomm.net` on an Azure
# managed domain, or a sender username created under a custom one.
ACS_EMAIL_SENDER_ADDRESS=
