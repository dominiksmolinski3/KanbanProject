<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>pl.myproject</groupId>
    <artifactId>KanbanProject2</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>KanbanProject2</name>
    <description>KanbanProject2</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <postgresql.version>42.7.13</postgresql.version>
        <tomcat.version>10.1.59</tomcat.version>
        <jackson-databind-nullable.version>0.2.11</jackson-databind-nullable.version>
        <azure-sdk-bom.version>1.3.8</azure-sdk-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              The Azure SDK ships azure-core, the Email client and the HTTP transport as separate
              artifacts on separate release trains, and only the combinations the BOM names are
              tested together. Picking versions by hand is how you end up with a NoSuchMethodError
              between azure-core and a transport built against a different one.
            -->
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.2.0</version>
        </dependency>
        <!--
          Mail goes out over the Azure Communication Services REST API, not SMTP, so there is no
          spring-boot-starter-mail here and no jakarta.mail on the classpath.

          The client defaults to the Netty transport, which drags Netty and Reactor Netty into a
          Tomcat application that has no other use for them. Excluding it and putting
          azure-core-http-jdk-httpclient on the classpath instead leaves the SDK to find the JDK's
          own HttpClient through the ServiceLoader - AcsEmailSenderTest exercises the whole
          pipeline against a stub server, so a mis-wired transport fails the build rather than
          the first signup.
        -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-communication-email</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-core-http-jdk-httpclient</artifactId>
        </dependency>
        <!--
          Task attachments live in Azure Blob Storage, not in Postgres.

          The two artifacts are separate on purpose. azure-storage-blob puts the bytes there;
          azure-identity is what signs the download links without an account key existing at all -
          the container app authenticates as its managed identity, asks the service for a user
          delegation key, and signs a five-minute read SAS with it. See AzureBlobStore.

          Both exclude Netty for the reason the Email client does: AzureTransportTest asserts it is
          not on the classpath, so one artifact dragging it back in fails the build rather than
          quietly deciding the transport lookup.
        -->
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-storage-blob</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.azure</groupId>
            <artifactId>azure-identity</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.azure</groupId>
                    <artifactId>azure-core-http-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation API (jakarta) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!--
            Jackson maps both an absent property and an explicit JSON null onto the same Java null,
            which is why every PATCH here used to mean "leave unchanged" and nothing could be
            cleared. JsonNullable keeps the two apart: undefined() for absent, of(null) for null.
        -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${jackson-databind-nullable.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          Flyway owns the schema now; Hibernate only validates against it. flyway-database-postgresql
          is a separate artifact from Flyway 10 onwards - without it the core library refuses to run
          against Postgres at all rather than falling back to something generic.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <excludes>
                        <exclude>**/KanbanProject2Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.task.subtask</include>
                                        <include>pl.myproject.kanbanproject2.chat</include>
                                        <include>pl.myproject.kanbanproject2.user.auth</include>
                                        <include>pl.myproject.kanbanproject2.config.security.ratelimit</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  mail is new this branch and measures 93.6 over 94 lines. A new
                                  package with no rule of its own lands on the 0.15 catch-all,
                                  which is the pressure that makes one get written; 0.85 is a
                                  shade under with room for the relay to grow a branch, and the
                                  same ratio config.security.captcha carries at a similar size.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.mail</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  storage and task.attachment arrive together with this branch and
                                  measure 100 over 36 lines and 94.3 over 140. storage is small
                                  because closing the storage account deleted the SAS machinery -
                                  delegation keys, signed response headers, the public-endpoint
                                  rewrite - so the floor stays at 0.90 rather than a shade under
                                  100: at 36 lines a 0.95 floor is two lines from a tripwire, which
                                  is the same reasoning the file rule below states. What
                                  task.attachment still does not cover is the after-commit branch
                                  of the transaction hook, which needs a real transaction manager
                                  to reach.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.storage</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.task.attachment</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.config.security.captcha</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.controller</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.board</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.user</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- 0.80, up from 0.70: measures 83.8, having been 73.5
                                                 for four rounds. SupportedLocales arrived with a
                                                 suite of its own and the locale patch added cases
                                                 to a service that had none, so the package got
                                                 larger in the tested direction. -->
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.exception</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.task</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.config.security</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.45</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  service measures 77.5, up from 59.7 and from the low forties
                                  before that: EmailService lost the MimeMessage assembly to the
                                  Azure client, then lost the message bodies to MailTemplates,
                                  which arrived with a test per message. It shared the 0.45 rule
                                  with config.security, which measures 83 and was held back by it;
                                  splitting them is what let this one start moving at all.

                                  0.70 rather than a shade under 77.5, because the package is 111
                                  lines and the two smallest packages get the same kind of slack
                                  for the same reason - at this size a floor set three lines away
                                  is a tripwire, not a ratchet.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.service</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- 0.75, up from 0.70: measures 81.2, having been 77.7
                                                 last round. The nine bundles are exercised through
                                                 MailTemplates rather than read, so every message in
                                                 every language is rendered by a test. Not 0.80: at
                                                 133 lines a floor that close is a tripwire. -->
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  file measures 97.7 and task.history 100, both up from the high
                                  thirties. The floor is 0.90 rather than a shade under each,
                                  because these are the two smallest packages in the build - 43 and
                                  17 lines - and at that size a 0.95 floor is one uncovered line
                                  away from failing, which turns the ratchet into a tripwire.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.file</include>
                                        <include>pl.myproject.kanbanproject2.task.history</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  The two layout packages were the least covered code in the
                                  project at 27.5 and 28.2; they measure 77.5 and 78.3 now. What is
                                  left uncovered in each is the controller, which has no slice test
                                  yet - that is the next thing to raise this.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.layout.column</include>
                                        <include>pl.myproject.kanbanproject2.layout.row</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.config.websocket</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.25</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  config measures 74.6 and no longer belongs on the websocket floor
                                  it was sharing. 0.70 rather than a shade under, because the
                                  package is 63 lines: at that size the gap between 0.746 and 0.70
                                  is three lines, which is as tight as this ratchet should get.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>pl.myproject.kanbanproject2.config</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  The catch-all, and the reason a brand-new package cannot hide:
                                  anything not named above starts at 0% and fails the build, so the
                                  way out is a test or an explicit rule rather than a lower number.
                                  Nothing sits on it today - every package in the build is named.
                                -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.15</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!--
                                  The bundle rule catches what per-package floors cannot: a large
                                  untested addition inside a package that is already well covered.
                                  81.3 measured, so 0.80.
                                -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
