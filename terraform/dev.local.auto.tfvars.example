# Copy this file to dev.local.auto.tfvars (excluded by .gitignore) and set your current public IP.
# It will be picked up automatically by Terraform and override variables from dev.tfvars without committing secrets.

# Optional: set this if Terraform cannot determine the subscription from Azure CLI.
# subscription_id = "00000000-0000-0000-0000-000000000000"

# Terraform writes secrets to Key Vault over its data plane, and the vault denies public
# traffic by default. Applying from a workstation therefore needs your own public IP here;
# nothing looks it up for you, on purpose -- see terraform/README.md#key-vault-network-access.
# Find it with: (Invoke-RestMethod https://api.ipify.org)
key_vault_allowed_ips = ["203.0.113.42"]  # replace with your IP
# allowed_ingress_cidrs = ["203.0.113.42/32"]  # optional; locks Container App ingress to these IPv4 CIDRs. Empty = open to the internet.
# key_vault_allow_azure_services_bypass = true  # optional override

spring_mail_username = "you@example.com"
spring_mail_password = ""   # Gmail app password
captcha_enabled = true
captcha_secret  = ""        # reCAPTCHA server-side secret
vite_recaptcha_site_key = ""
# app_image_tag = "latest"  # optional; defaults to "latest". Pin to a git SHA for reproducible deploys.
alert_email = "you@example.com"
