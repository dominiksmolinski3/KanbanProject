server_tokens off;

server {
    listen 443 ssl;

    ssl_certificate     {{ monitoring_pki_dir }}/server.crt;
    ssl_certificate_key {{ monitoring_pki_dir }}/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 16m;
    access_log /var/log/nginx/prometheus.access.log;

    location = /healthz {
        return 200 "ok\n";
    }

    location = /api/v1/otlp/v1/metrics {
        limit_except POST {
            deny all;
        }
        auth_basic           "push";
        auth_basic_user_file /etc/nginx/htpasswd.push;
        proxy_pass           http://127.0.0.1:9090;
    }

    location ~ ^/api/v1/(query|query_range|query_exemplars|series|labels|label/[^/]+/values|metadata|rules|alerts|status/buildinfo|format_query)$ {
        limit_except GET POST {
            deny all;
        }
        auth_basic           "read";
        auth_basic_user_file /etc/nginx/htpasswd.read;
        proxy_pass           http://127.0.0.1:9090;
    }

    location / {
        return 404;
    }
}
