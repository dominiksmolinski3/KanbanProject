map $http_x_request_id $edge_request_id {
    "~^[A-Za-z0-9_-]{8,64}$" $http_x_request_id;
    default                  $request_id;
}

log_format edge '$remote_addr - $remote_user [$time_local] "$request" $status '
                '$body_bytes_sent "$http_referer" "$http_user_agent" '
                'rid=$edge_request_id upstream_status=$upstream_status '
                'request_time=$request_time upstream_time=$upstream_response_time';

map $http_x_forwarded_for $edge_client {
    "~(?:^|,)\s*(?<last_hop>[^,\s]+)\s*$" $last_hop;
    default                                 $remote_addr;
}

limit_req_zone $edge_client zone=edge_api:10m rate=50r/s;
limit_req_zone $edge_client zone=edge_ws:10m rate=5r/s;
limit_req_zone $edge_client zone=edge_shell:10m rate=20r/s;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    access_log /var/log/nginx/access.log edge;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # A variable so the upstream is re-resolved; proxy_pass must carry no URI part, or nginx rewrites every path.
    set $api_upstream ${API_UPSTREAM};

    # Both default off: the internal ingress routes by SNI, and verify is what authenticates the hop.
    proxy_ssl_server_name         on;
    proxy_ssl_name                $proxy_host;
    proxy_ssl_verify              on;
    proxy_ssl_verify_depth        3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    limit_req_status    429;
    limit_req_log_level info;
    error_page 429 = @rate_limited;

    location @rate_limited {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Retry-After 1 always;
        default_type application/json;
        return 429 '{"code":"TOO_MANY_REQUESTS","message":"Too many requests, please try again later"}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        limit_req zone=edge_api burst=200 nodelay;
        proxy_pass $api_upstream;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-Id      $edge_request_id;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;

        client_max_body_size    12m;

        proxy_request_buffering off;
        proxy_buffering         off;
        proxy_read_timeout      300s;
    }

    location /ws/ {
        limit_req zone=edge_ws burst=30 nodelay;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-Id      $edge_request_id;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_buffering    off;
        proxy_read_timeout 3600s;
    }

    location /v3/api-docs {
        limit_req zone=edge_api burst=200 nodelay;
        proxy_pass $api_upstream;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Request-Id      $edge_request_id;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    # Without this, try_files below answers /actuator with the app shell and a 200.
    location /actuator {
        access_log off;
        return 404;
    }

    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        limit_req zone=edge_shell burst=100 nodelay;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
