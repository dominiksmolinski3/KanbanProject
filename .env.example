# Copy this file to `.env` in the repository root and fill in real values:
#   cp .env.example .env
#
# docker-compose reads it automatically. `.env` is gitignored -- never commit real
# credentials, and never put them in application.properties either.

# --- PostgreSQL (shared by the app container and the postgres service) ---
SPRING_DATASOURCE_DB=kanban
SPRING_DATASOURCE_USERNAME=kanban
SPRING_DATASOURCE_PASSWORD=

# --- Auth ---
# Signing key for JWTs. Generate one, e.g.: openssl rand -base64 32
JWT_SECRET_KEY=

# --- Mail (delivers the signup verification codes) ---
ACS_EMAIL_CONNECTION_STRING=
ACS_EMAIL_SENDER_ADDRESS=

# --- Attachments (Azure Blob Storage) ---
# LEAVE THIS BLANK. It is here to be overridden, not to be filled in.
#
# Blank means docker-compose points the app at its own azurite service, which is what you want
# locally and is the only reason this line exists.
#
# A deployed account never uses it at all: Terraform creates the storage account and passes the
# app AZURE_STORAGE_BLOB_ENDPOINT and AZURE_STORAGE_IDENTITY_CLIENT_ID from its own outputs, and
# the app authenticates as its managed identity. There is nothing to paste, and nothing could be
# pasted - the account sets shared_access_key_enabled = false, so it has no key, and a connection
# string is an account name and a key.
AZURE_STORAGE_CONNECTION_STRING=

# --- Google reCAPTCHA ---
# The site key is baked into the frontend bundle at build time (Docker build arg);
# leave it empty to render the login form without the widget.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
VITE_RECAPTCHA_SITE_KEY=
